# ---- 복사해서 .env 로 사용하고 실제 값으로 채우세요 (.env 는 커밋 금지) ----

# PostgreSQL
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=change-me-postgres-password

# Backend DB 접속 (compose 내부 호스트명 = postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/diary

# Kakao OAuth2 (https://developers.kakao.com 에서 발급)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8081/login/oauth2/code/kakao

# JWT (충분히 긴 랜덤 문자열, 최소 32바이트 권장)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# 프론트엔드 URL (OAuth 성공 후 리다이렉트 대상)
APP_FRONTEND_URL=http://localhost:8080
